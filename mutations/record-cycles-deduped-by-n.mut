target: internal/record/record.go
verify: go test ./internal/record/ -count=1 -run 'TestRestartsRepeatedCycleNumberIsKept'
expect: a repeated n was collapsed
why:    a Step 13 restart resets the cycle counter, so two rows legitimately share n=1; collapsing them deleted the first pass of every restart from the spend, and the cap counted 20 of the 40 agents actually used
--- old
		if phase, _ := rec["phase"].(string); phase == "cycle" {
			r.Cycles = append(r.Cycles, rec)
			continue
		}
--- new
		if phase, _ := rec["phase"].(string); phase == "cycle" {
			for i, c := range r.Cycles {
				if num(c["n"]) == num(rec["n"]) {
					r.Cycles[i] = rec
					return runs, nil
				}
			}
			r.Cycles = append(r.Cycles, rec)
			continue
		}
