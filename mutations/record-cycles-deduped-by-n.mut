target: internal/record/record.go
verify: go test ./internal/record/ -count=1 -run 'TestRestartsRepeatedCycleNumberIsKept'
expect: a repeated n was collapsed
why:    a Step 13 restart resets the cycle counter, so two rows legitimately share n=1; collapsing them deleted the first pass of every restart from the spend, and the cap counted 20 of the 40 agents actually used. Re-anchored for the typed port.
--- old
			r.Cycles = append(r.Cycles, c)
--- new
			replaced := false
			for i, ex := range r.Cycles {
				if ex.N != nil && c.N != nil && *ex.N == *c.N {
					r.Cycles[i], replaced = c, true
					break
				}
			}
			if !replaced {
				r.Cycles = append(r.Cycles, c)
			}
