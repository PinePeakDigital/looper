target: internal/record/record.go
verify: go test ./internal/record/ -count=1 -run 'TestConvergenceRules'
expect: a_converged_last_cycle_wins_over_a_cap_it_also_reached
why:    the converged test is placed before the capped test deliberately: a last cycle that applied nothing has finished the work even if the spend also reached the cap, and reporting `capped` there would understate a run that actually converged. Every fixture but one has only one of the two predicates true, so swapping the branches passed the entire suite AND the Python parity gate — the ordering was free to invert until the both-true case existed.
--- old
	if isZero(last["applied"]) && !truthy(last["asked"]) && !truthy(last["analysis_changed"]) {
		return Converged
	}

	cap := num(r.Fields["agent_cap"])
	var spent float64
	for _, c := range r.Cycles {
		spent += num(c["agents"])
	}
	// `cap != 0`, not `cap > 0`: the Python guard is a bare `if cap`, so a negative cap is
	// truthy there and any spend clears it. cmd_plan refuses a non-positive --agent-cap,
	// so no NEW row can carry one, but the store is append-only and never rewritten, so a
	// legacy or hand-written row still reads differently in the two implementations.
	if cap != 0 && spent >= cap {
		return Capped
	}
--- new
	cap := num(r.Fields["agent_cap"])
	var spent float64
	for _, c := range r.Cycles {
		spent += num(c["agents"])
	}
	// `cap != 0`, not `cap > 0`: the Python guard is a bare `if cap`, so a negative cap is
	// truthy there and any spend clears it. cmd_plan refuses a non-positive --agent-cap,
	// so no NEW row can carry one, but the store is append-only and never rewritten, so a
	// legacy or hand-written row still reads differently in the two implementations.
	if cap != 0 && spent >= cap {
		return Capped
	}

	if isZero(last["applied"]) && !truthy(last["asked"]) && !truthy(last["analysis_changed"]) {
		return Converged
	}
