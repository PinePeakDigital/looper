target: internal/docs/docs.go
verify: go test ./internal/docs/ -count=1 -run 'TestFlagsAreAttributedPerScript'
why:    a flag is credited to the first script named on the line rather than the one it belongs to
--- old
					out = append(out, Reference{Doc: rel, Line: i + 1, Script: script[1], Flag: flag[1]})
--- new
					out = append(out, Reference{Doc: rel, Line: i + 1, Script: named[0][1], Flag: flag[1]})
