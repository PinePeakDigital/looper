target: internal/learn/learn.go
verify: go test ./internal/learn/ -count=1 -run 'TestLearnMatchesThePython/bump_first_of_two'
expect: --- FAIL:
why:    bump re-dates the ONE entry the caller judged a re-match. A substring is loose, so re-dating every entry containing it would refresh unrelated entries and keep them from ever aging out.
--- old
	for i, ln := range lines {
		if m := entryRe.FindStringSubmatch(ln); m != nil && strings.Contains(m[2], match) {
			lines[i] = "- " + today + ": " + m[2]
			return true
		}
	}
	return false
--- new
	hit := false
	for i, ln := range lines {
		if m := entryRe.FindStringSubmatch(ln); m != nil && strings.Contains(m[2], match) {
			lines[i] = "- " + today + ": " + m[2]
			hit = true
		}
	}
	return hit
