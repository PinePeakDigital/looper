target: internal/record/record.go
verify: go test ./internal/record/ -count=1 -run 'TestConvergenceRules'
expect: convergence = "converged", want "unknown"
why:    a run with no cycle rows must never read as converged, or omitting the rows buys a silent clean push — which is the whole reason convergence is derived rather than asserted
--- old
	if len(r.Cycles) == 0 {
		return Unknown
	}
--- new
	if len(r.Cycles) == 0 {
		return Converged
	}
